# 复制为 .env 后按需修改（.env 不会提交到 Git）

# 生产环境务必更换为随机长字符串
SECRET_KEY=please-change-me-to-a-long-random-string

# 监听地址：0.0.0.0 允许局域网访问；127.0.0.1 仅本机
HOST=0.0.0.0
PORT=5000

# 开发调试：1 开启 Flask debug；生产保持 0
FLASK_DEBUG=0

# Waitress 工作线程数
WAITRESS_THREADS=4

# DeepSeek 智能加药（勿提交真实 Key 到公开仓库）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT=60

# 百度智能云语音（TTS + 短语音识别）
# 在控制台创建应用后填写 API Key / Secret Key；勿提交真实密钥
BAIDU_API_KEY=
BAIDU_SECRET_KEY=
# 可选：临时 Access Token（也可用 Key/Secret 自动获取）
BAIDU_ACCESS_TOKEN=
# 语速 0-15（认知训练建议 3-5）；发音人 0女声/1男声/3情感男/4情感女
BAIDU_TTS_SPD=4
BAIDU_TTS_PER=0
# 标准版 server_api；极速版可改为 https://vop.baidu.com/pro_api
BAIDU_ASR_URL=https://vop.baidu.com/server_api
# 小智 MCP 桥接本站 API（本机调用）
# 与 xiaozhi-mcp/.env 中 WEBSITE_MCP_TOKEN 保持一致
MCP_API_TOKEN=memory-harbor-mcp-dev-token
# 可选：指定老人用户 id；不填则自动取第一个老人账号
MCP_ELDER_USER_ID=0
MCP_API_BASE=http://127.0.0.1:5000
