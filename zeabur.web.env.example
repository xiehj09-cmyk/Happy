# Zeabur · web 服务环境变量（控制台 Variables 里按行粘贴）
# 格式示例：
# PASSWORD=XVTLW39re81Nbn47Pl5m2dHM0haEJ6sZ
# PORT=${WEB_PORT}
#
# 说明：
# - PORT 请用 Zeabur 注入的 ${WEB_PORT}（不要写死 5000/8080）
# - 带 Key/Secret/Token 的项请填真实值，勿提交到 Git
# - SECRET_KEY / MCP_API_TOKEN 请换成随机长字符串

HOST=0.0.0.0
PORT=${WEB_PORT}
FLASK_DEBUG=0
TRUST_PROXY=1
WAITRESS_THREADS=4

SECRET_KEY=请换成随机长字符串
MCP_API_TOKEN=请与 mcp 服务 WEBSITE_MCP_TOKEN 保持一致
MCP_ELDER_USER_ID=0

# —— DeepSeek（智能加药 / AI 陪伴 / CST 扩展）——
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT=60

# —— 百度智能云语音（TTS + ASR）——
BAIDU_API_KEY=
BAIDU_SECRET_KEY=
BAIDU_ACCESS_TOKEN=
BAIDU_TTS_SPD=4
BAIDU_TTS_PER=0
BAIDU_ASR_URL=https://vop.baidu.com/server_api
BAIDU_ASR_DEV_PID=1537
